# Leave both empty to run the self-contained demo mode (browser storage + cross-tab realtime).
# Fill both to run against Supabase. Only the public anon key belongs here — never the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public origin used when printing QR codes (defaults to the current origin).
VITE_PUBLIC_APP_URL=
